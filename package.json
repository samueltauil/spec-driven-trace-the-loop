{
  "name": "spec-driven-trace-the-loop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "validate:spec": "openspec validate --all --strict --no-interactive",
    "test": "npm run test:unit && npm run test:bdd",
    "test:unit": "node --test \"tests/*.test.js\"",
    "test:bdd": "cucumber-js",
    "check": "npm run validate:spec && npm test"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@fission-ai/openspec": "2.0.0"
  }
}
